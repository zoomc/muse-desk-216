# Local desk features; combine after sdkconfig.muse-waveshare-s3-216.
CONFIG_MUSE_DESK_FEATURES=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_desk.csv"
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_MUSE_TTS_BACKEND_MIMO=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_HOMEHUB_WIFI_CUSTOM_ROUTE=y

# Keep large USB screen captures out of the daily firmware.
# CONFIG_LV_USE_SNAPSHOT is not set
