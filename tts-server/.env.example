# Copy to /etc/muse-desk-216-tts.env (or a local .env) and edit. Never commit real values.
# Generate a token with: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MUSE_TTS_TOKEN=REPLACE_WITH_GENERATED_TOKEN
MUSE_TTS_VOICE=zh-CN-XiaoxiaoNeural
# Leave empty for direct access, or set your own HTTP proxy.
MUSE_TTS_PROXY=
